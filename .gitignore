# Build output and release artifacts
# Keep local installers here, but publish them as GitHub Release assets instead of source commits.
/release/
src-tauri/target/
src-tauri/gen/
coverage/

# Packaged installers and archives
*.tgz
*.msi
*.exe
*.deb
*.rpm
*.AppImage
*.dmg

# Private keys — never commit; regenerate with the cert generation script
office-addin/certs/*.key
office-addin/certs/*.crt
!office-addin/certs/.gitkeep

# Runtime repositories created by ovc
.office-vcs/
**/.office-vcs/


# Logs
*.log

# Environment and local config
.env
.env.*
!.env.example

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Temporary files
tmp/
temp/
*.tmp
