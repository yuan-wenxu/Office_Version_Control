{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OVC",
  "version": "2.1.0",
  "identifier": "com.ovc.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../app",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OVC",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#f5f7f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "resources": {
      "../office-addin": "office-addin"
    }
  }
}
